if HAVE_AFIDS_DATA
setup_afids_data = source $(AFIDS_DATA)/setup_afids_data.sh
else
setup_afids_data = :
endif
if HAVE_SPICE
setup_spice = export SPICEDATA="$(abs_top_srcdir)/@geocalunittestdata@/spice" && export MARS_KERNEL="$(abs_top_srcdir)/@geocalunittestdata@/mars_kernel"
else
setup_spice = :
endif
setup_geocal = $(setup_afids_data) && $(setup_spice) && source $(DESTDIR)$(prefix)/setup_geocal.sh

# Set to a non-empty value to install the python code in editable mode.
# Default comes from configure (--enable-python-editable-mode), and can be
# overridden for a single run with "make install PYTHON_EDITABLE_MODE=t"
# (or "PYTHON_EDITABLE_MODE=" to force a normal install).
# --force-reinstall is so switching modes really replaces the existing install.
PYTHON_EDITABLE_MODE = @python_editable_mode_default@

python-install:
	if test -n "$(PYTHON_EDITABLE_MODE)"; then \
	  pip install --prefix=@prefix@ --force-reinstall --no-deps -e $(abs_top_srcdir)/@srcpython@; \
	else \
	  pip install --prefix=@prefix@ --force-reinstall --no-deps $(srcdir)/@srcpython@; \
	fi

INSTALL_EXEC_HOOK+= python-install

#python-check:
#	$(setup_geocal) && pytest -n 10 $(srcdir)/@srcpython@/test

python-check:
	$(setup_geocal) && pytest -n 10 $(srcdir)/@srcpython@/tests 

INSTALLCHECK_HOOK+= python-check

 # This should go away, but leave for now
if HAVE_AFIDS
PYTHON_CHECK_PATH=$(afidspythonvdevdir):$(AFIDS_PREFIX)/bin:${PATH}:${GDAL_PREFIX}/bin
else
PYTHON_CHECK_PATH=$(afidspythonvdevdir):${PATH}:${GDAL_PREFIX}/bin
endif


