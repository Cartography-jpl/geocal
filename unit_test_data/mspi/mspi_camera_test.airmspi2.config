AIRMSPI2_CONFIG_CAMERA_MODEL_IR_0001.config : granule_id
1          : camera_mode  # 0 = MSPI (single focal plane, default); 1 = AirMSPI2 (dual focal planes)
0          : paraxial_y_mode #  1 = do not use real y input to paraxial y
0.010      : sample_pitch # pixel size along sample axis (millimeters)
31         : number_band
1280       : number_sample
3          : number_parameter
-1          : line_direction # positive line pitch is negative on focal plane y
29.856     : focal_length
-1         : sample_direction # sample number increase is negative on focal plane x
0          : boresight_angle
0          : camera_yaw   # Camera yaw angle in degrees
0          : camera_pitch # Camera pitch angle in degrees
0          : camera_roll  # Camera roll angle in degrees
-1         : inversion    # toggle frown / smile orientation

